{% extends 'layouts/page.njk' %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/input/macro.njk" import govukInput %}


{% block content %}
  {{ appHeading({
    text: heading,
    caption: "software-provider-management-poc"
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">

      {{ govukButton({
        text: "Retrieve Software Providers",
        href: switchOrganisationHref
      }) }}

      {% if isSuccess === true %}

        {% call govukNotificationBanner({ type: "success" }) %}
          <h3 class="govuk-notification-banner__heading">Software providers retrieved successfully.</h3>
        {% endcall %}

        {{ govukTable({
          caption: "Software Providers",
          captionClasses: "govuk-table__caption--m",
          firstCellIsHeader: true,
          head: [
              {
                text: "Name"
              },
              {
                text: "Client ID"
              }
            ],
          rows: rows
        }) }}

      {% elif isSuccess === false %}

        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: [
            {
              text: "Software provider retrieval failed."
            }
          ]
        }) }}

      {% endif %}

      <h2 class="govuk-heading-l">Create software provider</h2>

            <form method="post" action="{{ createClientHref }}">

              {{ govukInput({
                label: {
                  text: "Software provider name"
                },
                id: "software-provider-name",
                name: "softwareProviderName"
              }) }}

              {{ govukButton({
                text: "Submit",
                type: "submit"
              }) }}

            </form>

            {% if createdClients and createdClients.length > 0 %}

                    <h2 class="govuk-heading-l">Created software providers</h2>

                    {{ govukTable({
                      captionClasses: "govuk-table__caption--m",
                      firstCellIsHeader: true,
                      head: [
                          {
                            text: "Name"
                          },
                          {
                            text: "Client ID"
                          },
                          {
                            text: "Client Secret"
                          }
                        ],
                      rows: createdClients
                    }) }}

                  {% endif %}

    </div>
  </div>

{% endblock %}
